# NVIDIA_API_KEY: Required for live NVIDIA NIM AI inference (nvidia/nemotron-3.5-bolt-e4b).
# Obtain a key from https://build.nvidia.com and configure it in Vercel Project -> Settings -> Environment Variables.
# Strictly server-side only; never exposed to the client.
NVIDIA_API_KEY="nvapi-your-nvidia-api-key"

# NVIDIA_MODEL: Optional override for the NVIDIA NIM chat completions model.
NVIDIA_MODEL="nvidia/nemotron-3.5-bolt-e4b"

# NVIDIA_API_URL: Optional override for the NVIDIA NIM OpenAI-compatible completions endpoint.
NVIDIA_API_URL="https://integrate.api.nvidia.com/v1/chat/completions"

# NASA_API_KEY: Recommended for NASA APOD and NeoWs Planetary Defense endpoints (higher rate limits than DEMO_KEY).
# Obtain a free key at https://api.nasa.gov and add it in Vercel Environment Variables.
NASA_API_KEY="your-nasa-api-key"

# WEATHER_DATA (or OPENWEATHER_API): Required for OpenWeatherMap live observatory weather and air-pollution telemetry.
# Obtain a key at https://openweathermap.org/api and add it in Vercel Environment Variables.
WEATHER_DATA="your-openweathermap-api-key"

# AGRO_API: Required for Agromonitoring soil moisture, radiometric temperature, and solar UV telemetry.
# Obtain a key at https://agromonitoring.com/api and add it in Vercel Environment Variables.
AGRO_API="your-agromonitoring-api-key"

# APP_URL: Optional public deployment URL (Vercel automatically provides VERCEL_URL at runtime).
APP_URL="MY_APP_URL"
