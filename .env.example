# NVIDIA_API_KEY: Required for live NVIDIA NIM AI inference (nvidia/nemotron-3.5-bolt-e4b).
# Obtain a key from https://build.nvidia.com and configure it in the server environment or Secrets panel.
# Strictly server-side only; never exposed to the client.
NVIDIA_API_KEY="nvapi-your-nvidia-api-key"

# NVIDIA_MODEL: Optional override for the NVIDIA NIM chat completions model.
NVIDIA_MODEL="nvidia/nemotron-3.5-bolt-e4b"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
