# Server-side secrets. Configure these in Render Dashboard -> Service -> Environment.
# Never expose these values through VITE_* variables or commit real credentials.

# Recommended: Gemini powers the in-app science copilot and conversational astronomy guide.
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# Optional alternative AI provider. Gemini is preferred when GEMINI_API_KEY is configured.
NVIDIA_API_KEY="nvapi-your-nvidia-api-key"
NVIDIA_MODEL="nvidia/nemotron-3.5-bolt-e4b"
NVIDIA_API_URL="https://integrate.api.nvidia.com/v1/chat/completions"

# Recommended: free NASA API key for APOD and NeoWs. DEMO_KEY is rate-limited.
NASA_API_KEY="your-nasa-api-key"

# Optional integrations used by the environmental telemetry panels.
WEATHER_DATA="your-openweathermap-api-key"
AGRO_API="your-agromonitoring-api-key"

# Optional public origin and local-only SPHEREx FITS directory.
APP_URL="https://cosmic-frontier-spherex-demo.onrender.com"
SPHEREX_DATA_DIR="data/spherex"
